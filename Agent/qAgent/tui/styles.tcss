Screen {
    background: $background;
    color: $foreground;
}

#top-bar {
    height: 3;
    padding: 0 2;
    background: $panel;
    border-bottom: solid $boost;
    align: left middle;
}

#brand {
    width: auto;
    height: 1fr;
    content-align: left middle;
    color: $primary;
}

#session {
    width: 1fr;
    height: 1fr;
    content-align: right middle;
    color: $text-muted;
}

#usage {
    width: auto;
    height: 1fr;
    content-align: center middle;
    padding: 0 2;
}

/* ---- 主区：聊天 + MCP 边栏 ---- */

#body {
    height: 1fr;
}

#chat {
    width: 1fr;
    height: 1fr;
    padding: 1 3;
    background: $background;
    scrollbar-gutter: stable;
    scrollbar-color: $primary 40%;
    scrollbar-background: $surface;
}

#mcp-sidebar {
    width: 30;
    min-width: 24;
    height: 1fr;
    padding: 0 1;
    margin: 0;
    background: $panel;
    border-left: solid $boost;
    scrollbar-color: $primary 40%;
    scrollbar-background: $surface;
}

#sidebar-title {
    height: 1;
    padding: 0 0 0 1;
    background: $boost;
    color: $primary;
    text-style: bold;
}

.sidebar-body {
    height: auto;
    padding: 1 0 1 0;
    color: $foreground;
}

/* ---- MCP 边栏中的 Markdown 元素 ---- */

#mcp-sidebar MarkdownH3 {
    padding: 0;
    background: transparent;
    color: $text-muted;
    text-style: bold;
}

#mcp-sidebar MarkdownH4 {
    padding: 0;
    background: transparent;
    color: $secondary;
    text-style: bold;
}

#mcp-sidebar MarkdownH5 {
    padding: 0;
    background: transparent;
    color: $accent;
    text-style: bold;
}

#mcp-sidebar MarkdownH6 {
    padding: 0;
    background: transparent;
    color: $accent;
}

#mcp-sidebar MarkdownBullet {
    color: $foreground;
    margin: 0;
}

#mcp-sidebar MarkdownHr {
    display: none;
}

.message {
    height: auto;
    margin: 0 0 1 0;
    padding: 0 2;
    border-left: thick $primary;
}

.message-user {
    border-left: thick $accent;
    background: $surface;
}

.message-assistant {
    border-left: thick $success;
}

.message-tool {
    border-left: thick $warning;
    background: $boost;
}

.message-system {
    border-left: thick $boost;
}

.message-welcome {
    border-left: thick $primary;
    background: $surface;
}

.message-error {
    border-left: thick $error;
    background: $surface;
}

.message-role {
    height: auto;
    color: $text-muted;
    text-style: bold;
}

.message-user .message-role {
    color: $accent;
}

.message-assistant .message-role {
    color: $success;
}

.message-tool .message-role {
    color: $warning;
}

.message-welcome .message-role {
    color: $primary;
}

.message-error .message-role {
    color: $error;
}

.message-body {
    height: auto;
    margin: 0;
}

.message-tool .message-body {
    color: $text-muted;
}

#status-bar {
    height: 1;
    padding: 0 3;
    background: $surface;
    color: $text-muted;
}

/* ---- 斜杠命令补全面板 ---- */

#command-popup {
    display: none;
    height: auto;
    max-height: 10;
    margin: 0 2;
    padding: 0 0;
    background: $panel;
    border: round $boost;
    overflow-y: hidden;
}

#command-popup.popup-empty {
    display: none;
}

#command-popup .popup-option {
    height: 1;
    padding: 0 1;
    background: transparent;
    color: $foreground;
}

#command-popup .popup-option.selected {
    background: $boost;
    color: $primary;
}

#command-popup #popup-count {
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

#chat-input {
    height: 3;
    margin: 0 2;
    padding: 0 1;
    background: $surface;
    color: $foreground;
    border: round $boost;
}

#chat-input:focus {
    border: round $primary;
}

#hint-bar {
    height: 1;
    padding: 0 3;
    background: $panel;
    color: $text-muted;
}

/* ---- /compact 结果面板 ---- */

#cp-header {
    height: auto;
    padding: 0 1;
    background: $panel;
    color: $primary;
    text-style: bold;
}

#cp-columns {
    height: 1fr;
    padding: 1 1 0 1;
}

#cp-left,
#cp-right {
    width: 1fr;
    border: round $boost;
    background: $background;
    scrollbar-color: $primary 40%;
    scrollbar-background: $surface;
    padding: 0 1;
}

#cp-left {
    margin-right: 1;
}

#cp-footer {
    height: auto;
    padding: 1 1;
    background: $panel;
    align: right middle;
}

/* ---- 会话选择面板 ---- */

SessionListScreen {
    align: center middle;
}

#session-panel {
    width: 72;
    max-width: 90%;
    height: 22;
    max-height: 70%;
    background: $panel;
    border: round $primary;
    padding: 0;
}

#session-panel-title {
    height: 1;
    padding: 0 1;
    background: $boost;
    color: $primary;
    text-style: bold;
}

#session-list {
    height: 1fr;
    padding: 0 1;
    scrollbar-color: $primary 40%;
}

/* ---- 配置引导对话框 ---- */

ConfigDialog {
    align: center middle;
}

#config-dialog {
    background: $panel;
    border: heavy $warning;
    min-width: 60;
    padding: 1;
}

#config-dialog-title {
    height: auto;
    padding: 0 0 1 0;
    color: $warning;
    text-style: bold;
}

.config-dialog-body {
    padding: 0 1;
    color: $foreground;
}

#config-dialog-buttons {
    height: 3;
    padding: 1 0 0 0;
    align: center middle;
}

#config-dialog-hint {
    height: 1;
    text-align: center;
    color: $text-muted;
}
